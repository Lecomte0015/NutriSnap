{
  "expo": {
    "name": "NutriSnap",
    "slug": "nutrisnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrisnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutrisnap.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriSnap utilise la caméra pour analyser vos repas et calculer les calories.",
        "NSPhotoLibraryUsageDescription": "NutriSnap accède à vos photos pour analyser les repas sélectionnés.",
        "NSPhotoLibraryAddUsageDescription": "NutriSnap peut enregistrer des photos de vos repas."
      }
    },
    "android": {
      "package": "com.nutrisnap.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#eaf5f4"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "nutrisnap"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eaf5f4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NutriSnap a besoin d'accéder à la caméra pour scanner vos repas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriSnap accède à vos photos pour analyser la valeur nutritionnelle."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2fa4a7",
          "sounds": []
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e80637ac-c308-4148-8773-b3ddc61fc92b"
      }
    }
  }
}
